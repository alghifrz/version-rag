## Template environment file for VersionRAG
## Copy this to `src/.env` and fill in values.
## Note: `src/.env` is loaded via python-dotenv in multiple modules.

# ----------------------------
# Neo4j LOCAL (free; recommended)
# ----------------------------
# Neo4j Desktop defaults:
# - Browser UI: http://localhost:7474
# - Bolt URI:   bolt://localhost:7687
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="CHANGE_ME"

# The KG indexer/retriever currently uses these Aura-named variables.
# To run fully local WITHOUT changing code, point them to local as well:
NEO4J_URI_AURA="bolt://localhost:7687"
NEO4J_USERNAME_AURA="neo4j"
NEO4J_PASSWORD_AURA="CHANGE_ME"

# ----------------------------
# LLM keys (depends on util/constants.py -> LLM_MODE)
# ----------------------------
# Set LLM_MODE to choose which LLM to use:
# - openai: requires OPENAI_API_KEY
# - groq:  requires GROQ_API_KEY
LLM_MODE="groq"

# Choose embedding provider:
# - openai: requires OPENAI_API_KEY
# - local:  uses sentence-transformers (free)
EMBEDDING_PROVIDER="local"

# Optional overrides:
# EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
# EMBEDDING_DIMENSIONS="384"

OPENAI_API_KEY="CHANGE_ME"
GROQ_API_KEY="CHANGE_ME"

# Optional: pick Groq chat model (if a model is deprecated, change it here)
GROQ_MODEL="llama-3.3-70b-versatile"


